# ==================================
# CONFIGURAÇÃO DO SISTEMA
# ==================================

# Modelo Whisper para Transcrição de Áudio
# Opções: tiny, base, small, medium, large-v2, large-v3
# 
# Recomendações:
# - large-v2: Melhor qualidade, requer GPU ou 16GB+ RAM (PRODUÇÃO)
# - medium: Equilíbrio qualidade/velocidade, 8GB+ RAM (RECOMENDADO)
# - small: Rápido, qualidade OK, 4GB+ RAM (DESENVOLVIMENTO)
# - base: Muito rápido, qualidade inferior (NÃO RECOMENDADO)
#
WHISPER_MODEL=small

# 1 = modo rápido (melhor tempo), 0 = modo qualidade
WHISPER_SPEED_MODE=1
WHISPER_BEAM_SIZE=1
WHISPER_BEST_OF=1
WHISPER_TEMPERATURE=0.0

# ==================================
# DIARIZAÇÃO (Identificação de Locutores)
# ==================================
# Token HuggingFace necessário para identificar diferentes pessoas falando
# 
# Como obter:
# 1. Crie conta grátis em: https://huggingface.co/join
# 2. Obtenha token em: https://huggingface.co/settings/tokens
# 3. Aceite termos em: https://huggingface.co/pyannote/speaker-diarization
# 4. Cole o token abaixo:
#
HF_TOKEN=seu_token_aqui
PYANNOTE_TOKEN=seu_token_aqui

# ==================================
# OUTRAS CONFIGURAÇÕES (futuras)
# ==================================
# DATABASE_URL=postgresql://cyber:cyberpass123@postgres:5432/cyberlab
